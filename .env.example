# ────────────────────────────────────────────────────────────
#  گزارش فعالیت هیئت‌مدیره — نمونه‌ی متغیرهای محیطی
#  این فایل را به .env.local کپی کنید و مقادیر واقعی را بگذارید.
#  روی Vercel این مقادیر را در بخش Environment Variables وارد کنید.
# ────────────────────────────────────────────────────────────

# توکن بات تلگرام (از @BotFather)
TELEGRAM_BOT_TOKEN=

# رمز امنیتی وبهوک (یک رشته‌ی تصادفی دلخواه بسازید)
# همین مقدار هنگام ست‌کردن وبهوک هم استفاده می‌شود
TELEGRAM_WEBHOOK_SECRET=

# کلید API گوگل جِمِنای (از https://aistudio.google.com/apikey)
# ⚠️ سهمیه‌ی رایگان بین بات‌ها مشترک است؛ برای هر بات کلید جدا بگیرید.
GEMINI_API_KEY=

# مدل جِمِنای و زنجیره‌ی مدل‌های پشتیبان
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite

# رشته‌ی اتصال دیتابیس Postgres (از Neon)
DATABASE_URL=

# آی‌دی عددی گروه/چت‌های مجاز، با کاما جدا شوند (اختیاری؛ خالی = همه مجاز)
ALLOWED_CHAT_IDS=

# آدرس عمومی سایت روی Vercel (برای ست‌کردن وبهوک)
# مثال: https://board-report.vercel.app
PUBLIC_BASE_URL=

# سرویس تقویم تعطیلات رسمی (اختیاری؛ پیش‌فرض pnldev)
HOLIDAY_API_URL=

# رمزِ مسیرهای زمان‌بندی‌شده (Cron). Vercel آن را به‌صورت
# «Authorization: Bearer <مقدار>» می‌فرستد. اگر خالی بماند، هر کسی
# می‌تواند «بستن روز» را صدا بزند — پس حتماً پرش کنید.
CRON_SECRET=
